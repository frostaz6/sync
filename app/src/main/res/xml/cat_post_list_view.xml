<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.resync.app.ui.preferences.HeaderPreference />
    <com.resync.app.ui.preferences.custom.ViewChipGroundPreference />
    <com.resync.app.ui.preferences.custom.ViewTypePreviewPreference app:ui_mode="0" />
    <PreferenceCategory>
        <com.resync.app.ui.preferences.defaults.CategoryHeaderPreference app:categoryTitle="Image options" />
        <com.resync.app.ui.preferences.defaults.SyncCheckBoxPreference android:title="Thumbnails" android:key="compact_thumbnails" android:defaultValue="true" />
        <com.resync.app.ui.preferences.defaults.SyncCheckBoxPreference android:title="Type indicators" android:key="type_indicators" android:defaultValue="true" />
        <com.resync.app.ui.preferences.defaults.SyncCheckBoxPreference android:title="Align thumbnail right" android:key="thumbnail_align" android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory>
        <com.resync.app.ui.preferences.defaults.CategoryHeaderPreference app:categoryTitle="Fonts and sizing" />
        <com.resync.app.ui.preferences.defaults.SyncPreference android:title="Title font" android:key="list_title" />
        <com.resync.app.ui.preferences.defaults.SyncCheckBoxPreference android:title="Limit title to a single line" android:key="compact_single_lines" android:defaultValue="false" />
        <com.resync.app.ui.preferences.defaults.SyncPreference android:title="Description font" android:key="list_description" />
    </PreferenceCategory>
</PreferenceScreen>
