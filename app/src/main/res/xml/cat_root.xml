<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.resync.app.ui.preferences.HeaderPreference app:title="Settings" />
    <com.resync.app.ui.preferences.custom.SearchPreference />
    <com.resync.app.ui.preferences.custom.tooltips.RootLegacyTooltipPreference />
