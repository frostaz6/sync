<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/chat_thread_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20.0dp"
        android:paddingRight="20.0dp"
        android:paddingTop="18.0dp"
        android:paddingBottom="12.0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Chat"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20.0sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_weight="1.0">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_thread_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8.0dp"
            android:paddingBottom="8.0dp" />

        <TextView
            android:id="@+id/chat_thread_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24.0dp"
            android:alpha="0.7"
            android:text="Loading…"
            android:textColor="?android:attr/textColorPrimary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12.0dp"
        android:paddingRight="12.0dp"
        android:paddingTop="6.0dp"
        android:paddingBottom="6.0dp">

        <EditText
            android:id="@+id/chat_thread_input"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:hint="Message"
            android:maxLines="4"
            android:inputType="textCapSentences|textMultiLine" />

        <Button
            android:id="@+id/chat_thread_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8.0dp"
            android:text="Send" />
    </LinearLayout>
</LinearLayout>
