        <com.resync.app.ui.views.core.MaterialRow android:id="@id/more_copy" android:layout_width="match_parent" android:layout_height="wrap_content" app:rowImageSrc="@drawable/ic_content_copy_black_24dp" app:rowTitle="Copy..." />
