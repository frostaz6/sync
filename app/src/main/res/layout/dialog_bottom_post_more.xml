        <com.resync.app.ui.views.core.MaterialRow android:id="@id/more_add_multi" android:layout_width="match_parent" android:layout_height="wrap_content" app:rowImageSrc="@drawable/outline_playlist_add_24" app:rowTitle="Add to multi" />
